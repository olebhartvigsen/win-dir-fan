#include "resource.h"
IDI_APP      ICON        "app.ico"
IDI_APP_OPEN ICON        "app-open.ico"
IDI_APP_SCAN_0      ICON "app-scan-0.ico"
IDI_APP_SCAN_1      ICON "app-scan-1.ico"
IDI_APP_SCAN_2      ICON "app-scan-2.ico"
IDI_APP_SCAN_3      ICON "app-scan-3.ico"
IDI_APP_OPEN_SCAN_0 ICON "app-open-scan-0.ico"
IDI_APP_OPEN_SCAN_1 ICON "app-open-scan-1.ico"
IDI_APP_OPEN_SCAN_2 ICON "app-open-scan-2.ico"
IDI_APP_OPEN_SCAN_3 ICON "app-open-scan-3.ico"
IDI_SCAN_OVERLAY_0 ICON "scan-overlay-0.ico"
IDI_SCAN_OVERLAY_1 ICON "scan-overlay-1.ico"
IDI_SCAN_OVERLAY_2 ICON "scan-overlay-2.ico"
IDI_SCAN_OVERLAY_3 ICON "scan-overlay-3.ico"
IDR_MANIFEST RT_MANIFEST "app.manifest"

// Version resource — provides the "FanFolder" name shown in the taskbar jump list
#include <winver.h>
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,4,3,0
PRODUCTVERSION  1,4,3,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"   // English (US), Unicode
        BEGIN
            VALUE "FileDescription",  "FanFolder"
            VALUE "ProductName",      "FanFolder"
            VALUE "CompanyName",      ""
            VALUE "FileVersion",      "1.4.3.0"
            VALUE "ProductVersion",   "1.4.3.0"
            VALUE "InternalName",     "FanFolder"
            VALUE "OriginalFilename", "FanFolder.exe"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Ole B\u00fclow Hartvigsen. All rights reserved."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
